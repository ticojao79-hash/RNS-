<script>
/* ============ CONFIG: único lugar para adaptar a página para outra unidade/cliente ============ */
const CONFIG = {
  whatsapp: "5500000000000",   // DDI + DDD + número, só dígitos. Ex.: 5511999998888
  defaultMessage: "Oi! Vim pela página da RNS Fitness e quero conhecer a academia.",
  address: "Rua Floriano Leite Ribeiro, 117, Parque Ribeirão Preto", // adicione a cidade para o mapa achar certo
  timezone: "America/Sao_Paulo"
};

/* ============ Tracking (GTM / Meta Pixel) ============ */
window.dataLayer = window.dataLayer || [];
function track(event, params) {
  window.dataLayer.push(Object.assign({ event: event }, params || {}));
}
function pixel(name) { if (typeof window.fbq === "function") window.fbq("track", name); }

function waUrl(msg) {
  return "https://wa.me/" + CONFIG.whatsapp + "?text=" + encodeURIComponent(msg || CONFIG.defaultMessage);
}

/* Links de WhatsApp e mapa */
document.querySelectorAll("[data-wa]").forEach(function (el) {
  el.href = waUrl(el.dataset.wa);
  el.target = "_blank";
  el.rel = "noopener";
});
document.querySelector(".js-maps").href = "https://www.google.com/maps/search/?api=1&query=" + encodeURIComponent(CONFIG.address);

document.addEventListener("click", function (e) {
  var el = e.target.closest("[data-track]");
  if (!el) return;
  track("cta_click", { cta_id: el.dataset.track });
  if (el.hasAttribute("data-wa")) pixel("Contact");
});

/* Formulário -> mensagem pronta no WhatsApp */
document.getElementById("lead-form").addEventListener("submit", function (e) {
  e.preventDefault();
  var form = e.currentTarget;
  var nome = form.nome.value.trim();
  if (!nome) { form.nome.focus(); form.nome.setAttribute("aria-invalid", "true"); return; }
  form.nome.removeAttribute("aria-invalid");
  var interesse = form.interesse.value;
  var msg = "Oi! Meu nome é " + nome + ". Vim pela página da RNS Fitness e quero: " + interesse.toLowerCase() + ".";
  track("generate_lead", { lead_interest: interesse });
  pixel("Lead");
  var w = window.open(waUrl(msg), "_blank", "noopener");
  if (!w) window.location.href = waUrl(msg);
});

/* ============ Status "aberta agora" a partir da própria tabela de horários ============ */
(function () {
  var rows = Array.prototype.slice.call(document.querySelectorAll("tr[data-days]"));
  var dayNames = ["domingo", "segunda", "terça", "quarta", "quinta", "sexta", "sábado"];
  var map = { Sun: 0, Mon: 1, Tue: 2, Wed: 3, Thu: 4, Fri: 5, Sat: 6 };

  function toMin(t) { var p = t.split(":"); return +p[0] * 60 + +p[1]; }
  function fmt(t) { var p = t.split(":"); return p[0] + "h" + (p[1] === "00" ? "" : p[1]); }
  function rowFor(d) { return rows.filter(function (r) { return r.dataset.days.split(",").map(Number).indexOf(d) > -1; })[0]; }

  function nowInZone() {
    var parts = new Intl.DateTimeFormat("en-US", { timeZone: CONFIG.timezone, weekday: "short", hour: "2-digit", minute: "2-digit", hour12: false }).formatToParts(new Date());
    var o = {};
    parts.forEach(function (p) { o[p.type] = p.value; });
    return { day: map[o.weekday], min: (+o.hour % 24) * 60 + +o.minute };
  }

  function update() {
    var n = nowInZone();
    var today = rowFor(n.day);
    var state = "closed", text = "";

    rows.forEach(function (r) {
      r.classList.remove("is-today");
      var t = r.querySelector(".tag"); if (t) t.remove();
    });
    if (today) {
      today.classList.add("is-today");
      var tag = document.createElement("span"); tag.className = "tag"; tag.textContent = "Hoje";
      today.querySelector("th").appendChild(tag);
    }

    if (today && n.min >= toMin(today.dataset.open) && n.min < toMin(today.dataset.close)) {
      state = "open";
      text = "Aberta agora, fecha às " + fmt(today.dataset.close);
    } else {
      var when = "";
      if (today && n.min < toMin(today.dataset.open)) {
        when = "hoje às " + fmt(today.dataset.open);
      } else {
        for (var i = 1; i <= 7; i++) {
          var d = (n.day + i) % 7, r = rowFor(d);
          if (r) { when = (i === 1 ? "amanhã" : dayNames[d]) + " às " + fmt(r.dataset.open); break; }
        }
      }
      text = "Fechada agora, abre " + when;
    }

    document.querySelectorAll(".js-status").forEach(function (el) { el.dataset.state = state; });
    document.querySelectorAll(".js-status-text").forEach(function (el) { el.textContent = text; });
  }

  update();
  setInterval(update, 60000);
})();
</script>
